# Database Configuration
# Replace with your actual PostgreSQL connection string

# Option 1: Neon (Recommended - Free serverless PostgreSQL)
# Get your connection string from: https://neon.tech
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Option 2: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/binance_clone

# Option 3: Docker Compose (see docker-compose.yml)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/binance_clone
